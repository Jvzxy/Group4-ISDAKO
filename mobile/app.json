{
  "expo": {
    "name": "ISDAKO",
    "slug": "isdako",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.isdako.app"
    },
    "android": {
      "package": "com.isdako.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e3a52"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ISDAKO uses the camera to scan QR codes."
        }
      ]
    ]
  }
}
