# Copy the values you need into your shell or hosting dashboard.
# (The server reads real environment variables; it does not load this file by itself.)

# Staff PIN. Required when NODE_ENV=production.
STAFF_PIN=change-me

PORT=3000

# Where the database is kept (default: ./data)
# DATA_DIR=./data

# Set to 1 when the server sits behind a proxy such as nginx or Cloudflare
# TRUST_PROXY=1

# ---- SMS alerts -------------------------------------------------------------
# off        = never send
# console    = print the SMS in the server log instead of sending (default, for testing)
# semaphore  = Semaphore (Philippines) https://semaphore.co
# twilio     = Twilio https://www.twilio.com
SMS_PROVIDER=console

# Semaphore
# SEMAPHORE_API_KEY=your-api-key
# SEMAPHORE_SENDER=ISDAKO        # optional; must be a Sender Name registered in your Semaphore account

# Twilio (use TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...
